options
{
  STATIC = false;
}

PARSER_BEGIN(Compilaco)
package parser;

public class Compilaco
{

}
PARSER_END(Compilaco)

SKIP :
{
  " " | "\r" | "\t" | "\n"
}

/* TOKENS DA LINGUAGEM - TEMÁTICA FUTEBOL */
TOKEN : 
{
  < ABREMAIN    : "apito_inicial" >
| < FECHAMAIN   : "fim_de_jogo" >
| < ABREPAREN   : "(" >
| < FECHAPAREN  : ")" >
| < ABREBLOCO   : "{" >
| < FECHABLOCO  : "}" >
| < VIRGULA     : "," >
| < ATRIBUICAO  : "=" >
| < FIMINSTRUCT : ";" >

/* TIPOS DE DADOS */
| < TIPOINT     : "placar" >
| < TIPOFLOAT   : "estatistica" >
| < TIPOSTRING  : "narracao" >

/* ESTRUTURAS DE CONTROLE */
| < IF          : "var_analisa" >
| < ELSE        : "segue_jogo" >
| < WHILE       : "enquanto_bola_rolar" >
| < FOR         : "campeonato" >

/* OPERADORES */
| < OP_REL      : ">=" | "<=" | "==" | "!=" | ">" | "<" >
| < OP_SOMA     : "+" | "-" >

/* IDENTIFICADORES E VALORES */
| < IDENTIFICADOR : ["a"-"z", "A"-"Z"](["a"-"z", "A"-"Z", "0"-"9", "_"])* >
| < CONSTANT      : (< DIGIT >)+ >
| < FLOAT_LIT     : (< DIGIT >)+ "." (< DIGIT >)+ >
| < STRING_LIT    : "\"" (~["\""])* "\"" >
| < #DIGIT        : [ "0"-"9" ] >
}

/* OPERADORES MULTIPLICATIVOS (maior precedência que OP_SOMA) */
TOKEN :
{
  < OP_MULT : "*" | "/" >
}

/* REGRAS SINTÁTICAS */

void inicio() :
{}
{
  < ABREMAIN > < ABREPAREN > < FECHAPAREN >
    ( comando() )*
  < FECHAMAIN > < EOF >
}

void comando() :
{}
{
    declaraVar() 
  | atribuicaoIsolada()
  | comandoIf() 
  | comandoWhile() 
  | comandoFor()
}

void tipoDado() :
{}
{
  < TIPOINT > | < TIPOFLOAT > | < TIPOSTRING >
}

void valor() :
{}
{
    < CONSTANT > | < FLOAT_LIT > | < STRING_LIT > | < IDENTIFICADOR >
}

/*
 * Expressões em níveis de precedência (do menor para o maior):
 *   expressao : comparação (no máximo um operador relacional)
 *   exprArit  : soma e subtração      (associativas à esquerda)
 *   termo     : multiplicação e divisão (associativas à esquerda)
 *   fator     : valor, parênteses ou sinal unário
 */
void expressao() :
{}
{
    exprArit() ( <OP_REL> exprArit() )?
}

void exprArit() :
{}
{
    termo() ( <OP_SOMA> termo() )*
}

void termo() :
{}
{
    fator() ( <OP_MULT> fator() )*
}

void fator() :
{}
{
    valor()
  | <ABREPAREN> expressao() <FECHAPAREN>
  | <OP_SOMA> fator()
}

/* Permite reatribuir valor a variáveis já existentes */
void atribuicaoIsolada() :
{}
{
    < IDENTIFICADOR > < ATRIBUICAO > expressao() < FIMINSTRUCT >
}

/* Declarar variáveis únicas ou em lista com/sem atribuição */
void declaraVar() :
{}
{
   tipoDado() 
   < IDENTIFICADOR > ( < ATRIBUICAO > expressao() )?
   ( < VIRGULA > < IDENTIFICADOR > ( < ATRIBUICAO > expressao() )? )* 
   < FIMINSTRUCT >
}

/* Estrutura Condicional (If / Else) */
void comandoIf() :
{}
{
    < IF > < ABREPAREN > expressao() < FECHAPAREN >
    < ABREBLOCO > ( comando() )* < FECHABLOCO >
    ( LOOKAHEAD(1) < ELSE > < ABREBLOCO > ( comando() )* < FECHABLOCO > )?
}

/* Laço 1 (While) */
void comandoWhile() :
{}
{
    < WHILE > < ABREPAREN > expressao() < FECHAPAREN >
    < ABREBLOCO > ( comando() )* < FECHABLOCO >
}

/* Laço 2 (For) */
void comandoFor() :
{}
{
    < FOR > < ABREPAREN > 
    tipoDado() <IDENTIFICADOR> <ATRIBUICAO> valor() <FIMINSTRUCT>
    expressao() <FIMINSTRUCT>
    <IDENTIFICADOR> <ATRIBUICAO> expressao()
    < FECHAPAREN >
    < ABREBLOCO > ( comando() )* < FECHABLOCO >
}