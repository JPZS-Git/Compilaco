options
{
  STATIC = true;
}

PARSER_BEGIN(Compilaco)
package parser;

public class Compilaco
{
  public static void main(String[] args)
  {
    boolean debug = false;
    boolean mostrarArvore = false;
    for (String arg : args) {
      if ("--debug".equalsIgnoreCase(arg)) {
        debug = true;
      }
      if ("--arvore".equalsIgnoreCase(arg)) {
        mostrarArvore = true;
      }
    }

    System.out.println("\n[Juiz em campo] Apito inicial!");
    System.out.println("Digite o código. A análise começa automaticamente ao encontrar 'fim_de_jogo'.\n");

    try {
      java.io.BufferedReader reader = new java.io.BufferedReader(
          new java.io.InputStreamReader(System.in, java.nio.charset.StandardCharsets.UTF_8)
      );

      StringBuilder codigo = new StringBuilder();
      String linha;
      boolean encontrouFim = false;

      while ((linha = reader.readLine()) != null) {
        codigo.append(linha).append('\n');

        if (linha.trim().equals("fim_de_jogo")) {
          encontrouFim = true;
          break;
        }
      }

      if (!encontrouFim) {
        System.err.println("[ERRO DE ENTRADA] O código terminou sem 'fim_de_jogo'.");
        return;
      }

      if (debug) {
        System.out.println("[DEBUG] Código recebido:");
        System.out.println("----------------------------------------");
        System.out.print(codigo);
        System.out.println("----------------------------------------");
      }

      java.io.ByteArrayInputStream input = new java.io.ByteArrayInputStream(
          codigo.toString().getBytes(java.nio.charset.StandardCharsets.UTF_8)
      );

      new Compilaco(input);

      if (debug) {
        imprimirTokens();

        java.io.ByteArrayInputStream inputParser = new java.io.ByteArrayInputStream(
            codigo.toString().getBytes(java.nio.charset.StandardCharsets.UTF_8)
        );
        Compilaco.ReInit(inputParser);

        System.out.println("[DEBUG] Iniciando análise sintática...");
      }

      No arvore = Compilaco.inicio();

      System.out.println("\n[GOL] Análise léxica e sintática concluída sem erros!");
      System.out.println("=> Fim de jogo! O código é sintaticamente válido.");

      if (debug || mostrarArvore) {
        System.out.println("\n[ARVORE SINTATICA]");
        System.out.print(arvore.imprimir());
      }
    }
    catch (TokenMgrError e) {
      System.err.println("\n[CARTÃO VERMELHO - ERRO LÉXICO] O juiz expulsou um símbolo do jogo!");
      System.err.println("-> " + e.getMessage());
    }
    catch (ParseException e) {
      imprimirErroSintatico(e);
    }
    catch (Exception e) {
      System.err.println("\n[ERRO INTERNO DO COMPILADOR]");
      e.printStackTrace();
    }
  }

  private static void imprimirTokens() {
    System.out.println("[DEBUG] Tokens reconhecidos pelo lexer:");

    while (true) {
      Token token = token_source.getNextToken();
      String nome = token.kind >= 0 && token.kind < tokenImage.length
          ? tokenImage[token.kind]
          : String.valueOf(token.kind);

      System.out.printf(
          "  linha %-3d coluna %-3d %-22s -> %s%n",
          token.beginLine,
          token.beginColumn,
          nome,
          token.kind == EOF ? "<EOF>" : "'" + token.image + "'"
      );

      if (token.kind == EOF) {
        break;
      }
    }

    System.out.println();
  }

  private static void imprimirErroSintatico(ParseException e) {
    System.err.println("\n[FALTA GRAVE - ERRO SINTÁTICO] O VAR interveio na compilação!");

    if (e.currentToken != null && e.currentToken.next != null) {
      Token token = e.currentToken.next;
      String imagem = token.kind == EOF ? "<EOF>" : token.image;

      System.err.println(
          "-> Token irregular encontrado: '" + imagem +
          "' na linha " + token.beginLine +
          ", coluna " + token.beginColumn
      );

      java.util.LinkedHashSet<String> esperados = new java.util.LinkedHashSet<>();
      for (int[] sequencia : e.expectedTokenSequences) {
        if (sequencia.length > 0) {
          esperados.add(tokenImage[sequencia[0]]);
        }
      }

      if (!esperados.isEmpty()) {
        System.err.println("-> A regra do jogo esperava: " + String.join(", ", esperados));
      }
    } else {
      System.err.println("-> " + e.getMessage());
    }
  }
}
PARSER_END(Compilaco)

SKIP :
{
  " " | "\r" | "\t" | "\n"
}

/* TOKENS DA LINGUAGEM - TEMÁTICA FUTEBOL */
TOKEN : 
{
  < ABREMAIN    : "apito_inicial" >
| < FECHAMAIN   : "fim_de_jogo" >
| < ABREPAREN   : "(" >
| < FECHAPAREN  : ")" >
| < ABREBLOCO   : "{" >
| < FECHABLOCO  : "}" >
| < VIRGULA     : "," >
| < ATRIBUICAO  : "=" >
| < FIMINSTRUCT : ";" >

/* TIPOS DE DADOS */
| < TIPOINT     : "placar" >
| < TIPOFLOAT   : "estatistica" >
| < TIPOSTRING  : "narracao" >

/* ESTRUTURAS DE CONTROLE */
| < IF          : "var_analisa" >
| < ELSE        : "segue_jogo" >
| < WHILE       : "enquanto_bola_rolar" >
| < FOR         : "campeonato" >

/* OPERADORES */
| < OP_REL      : ">=" | "<=" | "==" | "!=" | ">" | "<" >
| < OP_SOMA     : "+" | "-" >

/* IDENTIFICADORES E VALORES */
| < IDENTIFICADOR : ["a"-"z", "A"-"Z"](["a"-"z", "A"-"Z", "0"-"9", "_"])* >
| < CONSTANT      : (< DIGIT >)+ >
| < FLOAT_LIT     : (< DIGIT >)+ "." (< DIGIT >)+ >
| < STRING_LIT    : "\"" (~["\""])* "\"" >
| < #DIGIT        : [ "0"-"9" ] >
}

/* OPERADORES MULTIPLICATIVOS (maior precedência que OP_SOMA) */
TOKEN :
{
  < OP_MULT : "*" | "/" >
}

/* REGRAS SINTÁTICAS
 *
 * Cada regra devolve o seu nó da árvore sintática (classe No):
 *   - o nó tem o nome da regra (ex.: "termo");
 *   - os filhos são as sub-regras chamadas e os tokens consumidos, na ordem
 *     em que aparecem (ex.: termo -> fator, *, fator).
 */

No inicio() :
{ No no = new No("inicio"); Token t; No filho; }
{
  t = < ABREMAIN >   { no.add(t); }
  t = < ABREPAREN >  { no.add(t); }
  t = < FECHAPAREN > { no.add(t); }
    ( filho = comando() { no.add(filho); } )*
  t = < FECHAMAIN >  { no.add(t); }
  < EOF >
  { return no; }
}

/*
 * Quando o modo pânico for implementado, o catch deste comando deve devolver
 * um nó de erro no lugar do comando descartado, ex.:
 *   return no.add(No.erro("comando descartado"));
 * Assim a árvore continua sendo montada mesmo com erro.
 */
No comando() :
{ No no = new No("comando"); No filho; }
{
  (
      filho = declaraVar()
    | filho = atribuicaoIsolada()
    | filho = comandoIf()
    | filho = comandoWhile()
    | filho = comandoFor()
  )
  { return no.add(filho); }
}

No tipoDado() :
{ No no = new No("tipoDado"); Token t; }
{
  ( t = < TIPOINT > | t = < TIPOFLOAT > | t = < TIPOSTRING > )
  { return no.add(t); }
}

No valor() :
{ No no = new No("valor"); Token t; }
{
  ( t = < CONSTANT > | t = < FLOAT_LIT > | t = < STRING_LIT > | t = < IDENTIFICADOR > )
  { return no.add(t); }
}

/*
 * Expressões em níveis de precedência (do menor para o maior):
 *   expressao : comparação (no máximo um operador relacional)
 *   exprArit  : soma e subtração      (associativas à esquerda)
 *   termo     : multiplicação e divisão (associativas à esquerda)
 *   fator     : valor, parênteses ou sinal unário
 *
 * Como termo fica dentro de exprArit, em "2 + 3 * 4" o * aparece abaixo do +.
 */
No expressao() :
{ No no = new No("expressao"); Token t; No filho; }
{
    filho = exprArit() { no.add(filho); }
    (
      t = < OP_REL > filho = exprArit() { no.add(t).add(filho); }
    )?
    { return no; }
}

No exprArit() :
{ No no = new No("exprArit"); Token t; No filho; }
{
    filho = termo() { no.add(filho); }
    (
      t = < OP_SOMA > filho = termo() { no.add(t).add(filho); }
    )*
    { return no; }
}

No termo() :
{ No no = new No("termo"); Token t; No filho; }
{
    filho = fator() { no.add(filho); }
    (
      t = < OP_MULT > filho = fator() { no.add(t).add(filho); }
    )*
    { return no; }
}

No fator() :
{ No no = new No("fator"); Token t; Token t2; No filho; }
{
  (
      filho = valor() { no.add(filho); }
    | t = < ABREPAREN > filho = expressao() t2 = < FECHAPAREN >
      { no.add(t).add(filho).add(t2); }
    | t = < OP_SOMA > filho = fator() { no.add(t).add(filho); }
  )
  { return no; }
}

/* Permite reatribuir valor a variáveis já existentes */
No atribuicaoIsolada() :
{ No no = new No("atribuicao"); Token t; No filho; }
{
    t = < IDENTIFICADOR > { no.add(t); }
    t = < ATRIBUICAO >    { no.add(t); }
    filho = expressao()   { no.add(filho); }
    t = < FIMINSTRUCT >   { no.add(t); }
    { return no; }
}

/* Declarar variáveis únicas ou em lista com/sem atribuição */
No declaraVar() :
{ No no = new No("declaraVar"); Token t; No filho; }
{
   filho = tipoDado() { no.add(filho); }
   t = < IDENTIFICADOR > { no.add(t); }
   ( t = < ATRIBUICAO > filho = expressao() { no.add(t).add(filho); } )?
   (
     t = < VIRGULA > { no.add(t); }
     t = < IDENTIFICADOR > { no.add(t); }
     ( t = < ATRIBUICAO > filho = expressao() { no.add(t).add(filho); } )?
   )*
   t = < FIMINSTRUCT > { no.add(t); }
   { return no; }
}

/*
 * Nos comandos com bloco, os comandos entre { } ficam agrupados num nó "bloco"
 * (só na árvore; a gramática continua a mesma), para separar o bloco do
 * var_analisa do bloco do segue_jogo.
 */

/* Estrutura Condicional (If / Else) */
No comandoIf() :
{ No no = new No("comandoIf"); No bloco; Token t; No filho; }
{
    t = < IF >          { no.add(t); }
    t = < ABREPAREN >   { no.add(t); }
    filho = expressao() { no.add(filho); }
    t = < FECHAPAREN >  { no.add(t); }
    t = < ABREBLOCO >   { bloco = new No("bloco").add(t); no.add(bloco); }
      ( filho = comando() { bloco.add(filho); } )*
    t = < FECHABLOCO >  { bloco.add(t); }
    (
      LOOKAHEAD(1)
      t = < ELSE >        { no.add(t); }
      t = < ABREBLOCO >   { bloco = new No("bloco").add(t); no.add(bloco); }
        ( filho = comando() { bloco.add(filho); } )*
      t = < FECHABLOCO >  { bloco.add(t); }
    )?
    { return no; }
}

/* Laço 1 (While) */
No comandoWhile() :
{ No no = new No("comandoWhile"); No bloco; Token t; No filho; }
{
    t = < WHILE >       { no.add(t); }
    t = < ABREPAREN >   { no.add(t); }
    filho = expressao() { no.add(filho); }
    t = < FECHAPAREN >  { no.add(t); }
    t = < ABREBLOCO >   { bloco = new No("bloco").add(t); no.add(bloco); }
      ( filho = comando() { bloco.add(filho); } )*
    t = < FECHABLOCO >  { bloco.add(t); }
    { return no; }
}

/* Laço 2 (For) */
No comandoFor() :
{ No no = new No("comandoFor"); No bloco; Token t; No filho; }
{
    t = < FOR >           { no.add(t); }
    t = < ABREPAREN >     { no.add(t); }
    filho = tipoDado()    { no.add(filho); }
    t = < IDENTIFICADOR > { no.add(t); }
    t = < ATRIBUICAO >    { no.add(t); }
    filho = valor()       { no.add(filho); }
    t = < FIMINSTRUCT >   { no.add(t); }
    filho = expressao()   { no.add(filho); }
    t = < FIMINSTRUCT >   { no.add(t); }
    t = < IDENTIFICADOR > { no.add(t); }
    t = < ATRIBUICAO >    { no.add(t); }
    filho = expressao()   { no.add(filho); }
    t = < FECHAPAREN >    { no.add(t); }
    t = < ABREBLOCO >     { bloco = new No("bloco").add(t); no.add(bloco); }
      ( filho = comando() { bloco.add(filho); } )*
    t = < FECHABLOCO >    { bloco.add(t); }
    { return no; }
}
