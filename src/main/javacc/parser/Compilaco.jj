options
{
  STATIC = false;
}

PARSER_BEGIN(Compilaco)
package parser;

import java.util.ArrayList;
import java.util.List;
import recovery.*;

public class Compilaco
{
  /** Erros da compilação (léxicos e sintáticos), todos de uma vez. */
  public List<ErroCompilacao> erros = new ArrayList<ErroCompilacao>();

  /** Passo a passo da recuperação de erros (exibido com --debug). */
  public final List<String> rastro = new ArrayList<String>();

  /** Raiz da árvore; guardada para não perder a árvore parcial se o código acabar no meio de um erro. */
  private No raiz;

  /**
   * Cria o parser já com o léxico que se recupera de erros
   * (LexicoComRecuperacao). Léxico e parser gravam na mesma lista de erros.
   */
  public static Compilaco criar(java.io.Reader codigo)
  {
    List<ErroCompilacao> lista = new ArrayList<ErroCompilacao>();
    Compilaco parser = new Compilaco(new LexicoComRecuperacao(new SimpleCharStream(codigo), lista));
    parser.erros = lista;
    return parser;
  }

  /**
   * Analisa o programa inteiro e devolve a árvore sintática.
   * Onde houve recuperação de erro, a árvore tem um nó "erro" no lugar
   * do trecho descartado. Os erros ficam na lista "erros".
   */
  public No analisar()
  {
    try
    {
      return inicio();
    }
    catch (ParseEOFException e)
    {
      Token fim = getToken(1);
      boolean jaRegistrado = false;
      for (ErroCompilacao erro : erros)
        if (erro.linha() == fim.beginLine && erro.coluna() == fim.beginColumn)
          jaRegistrado = true;
      if (!jaRegistrado)
        erros.add(new ErroCompilacao(TipoErro.SINTATICO, fim.beginLine, fim.beginColumn,
            "Fim do código inesperado: faltou o fechamento de um bloco ou o 'fim_de_jogo'."));
      if (raiz == null) raiz = new No("inicio");
      return raiz.add(No.erro("fim do código inesperado"));
    }
    catch (ParseException e)
    {
      erros.add(ErroCompilacao.sintatico(e));
      return raiz != null ? raiz : No.erro("programa");
    }
  }

  /** Nome legível de um tipo de token (ex.: "placar" em vez de "\"placar\""). */
  static public String im(int x)
  {
    int k;
    String s;
    s = tokenImage[x];
    k = s.lastIndexOf("\"");
    try {
      s = s.substring(1,k);
    }
    catch (StringIndexOutOfBoundsException e)
    {}
    return s;
  }

  Token lastError = null;
  boolean eof;    // variável que indica se EOF foi alcançado

  // o método abaixo consome tokens até alcançar um que pertença ao conjunto
  // de sincronização (modo pânico)
  void consumeUntil(RecoverySet g,
                    ParseException e,
                    String met) throws ParseEOFException,
                                       ParseException
  {
    Token tok;
    rastro.add("*** " + met + " ***");
    rastro.add("     Conjunto de sincronização: " + g);

    if (g == null) throw e; // se o conjunto é null, propaga a exceção

    tok = getToken(1); // pega token corrente
    while ( ! eof ) { // se não chegou ao fim do arquivo
      if ( g.contains(tok.kind)) { // achou um token no conjunto
        rastro.add("     Encontrado token de sincronização: " + im(tok.kind));
        break;
      }
      rastro.add("     Ignorando o token: " + im(tok.kind));
      getNextToken();     // pega próximo token
      tok = getToken(1);
      if (tok.kind == EOF && ! g.contains(EOF) ) // fim da entrada?
        eof = true;
    }
    if ( tok != lastError ) { // evita mensagens em cascata
      if ( ! causadoPorErroLexico(e) )
        erros.add(ErroCompilacao.sintatico(e));
      lastError = tok;
    }
    if ( eof )
      throw new ParseEOFException("Encontrei EOF onde não deveria.");
  }

  /*
   * Evita cascata entre léxico e sintático: se um símbolo inválido foi
   * descartado logo antes do token inesperado (ex.: "2 @ 3", que chega ao
   * parser como "2 3"), o erro sintático é só consequência do léxico e
   * não é registrado de novo.
   */
  boolean causadoPorErroLexico(ParseException e)
  {
    Token antes = e.currentToken;
    Token achado = (antes != null) ? antes.next : null;
    if (antes == null || achado == null) return false;

    for (ErroCompilacao erro : erros)
    {
      if (erro.tipo() != TipoErro.LEXICO) continue;
      boolean depoisDoAnterior = erro.linha() > antes.endLine
          || (erro.linha() == antes.endLine && erro.coluna() > antes.endColumn);
      boolean antesDoAchado = erro.linha() < achado.beginLine
          || (erro.linha() == achado.beginLine && erro.coluna() < achado.beginColumn);
      if (depoisDoAnterior && antesDoAchado) return true;
    }
    return false;
  }

  /* Monta uma ParseException "esperava um destes tokens" a partir de um conjunto. */
  ParseException erroEsperando(RecoverySet esperados)
  {
    java.util.TreeSet<Integer> ordenados = new java.util.TreeSet<Integer>(esperados);
    int[][] sequencias = new int[ordenados.size()][];
    int i = 0;
    for (Integer k : ordenados)
      sequencias[i++] = new int[] { k.intValue() };
    return new ParseException(token, sequencias, tokenImage);
  }
}
PARSER_END(Compilaco)

SKIP :
{
  " " | "\r" | "\t" | "\n"
}

/* TOKENS DA LINGUAGEM - TEMÁTICA FUTEBOL */
TOKEN : 
{
  < ABREMAIN    : "apito_inicial" >
| < FECHAMAIN   : "fim_de_jogo" >
| < ABREPAREN   : "(" >
| < FECHAPAREN  : ")" >
| < ABREBLOCO   : "{" >
| < FECHABLOCO  : "}" >
| < VIRGULA     : "," >
| < ATRIBUICAO  : "=" >
| < FIMINSTRUCT : ";" >

/* TIPOS DE DADOS */
| < TIPOINT     : "placar" >
| < TIPOFLOAT   : "estatistica" >
| < TIPOSTRING  : "narracao" >

/* ESTRUTURAS DE CONTROLE */
| < IF          : "var_analisa" >
| < ELSE        : "segue_jogo" >
| < WHILE       : "enquanto_bola_rolar" >
| < FOR         : "campeonato" >

/* OPERADORES */
| < OP_REL      : ">=" | "<=" | "==" | "!=" | ">" | "<" >
| < OP_SOMA     : "+" | "-" >

/* IDENTIFICADORES E VALORES */
| < IDENTIFICADOR : ["a"-"z", "A"-"Z"](["a"-"z", "A"-"Z", "0"-"9", "_"])* >
| < CONSTANT      : (< DIGIT >)+ >
| < FLOAT_LIT     : (< DIGIT >)+ "." (< DIGIT >)+ >
| < STRING_LIT    : "\"" (~["\""])* "\"" >
| < #DIGIT        : [ "0"-"9" ] >
}

/* OPERADORES MULTIPLICATIVOS (maior precedência que OP_SOMA) */
TOKEN :
{
  < OP_MULT : "*" | "/" >
}

/* REGRAS SINTÁTICAS
 *
 * Cada regra devolve o seu nó da árvore sintática (classe No):
 *   - o nó tem o nome da regra (ex.: "termo");
 *   - os filhos são as sub-regras chamadas e os tokens consumidos, na ordem
 *     em que aparecem (ex.: termo -> fator, *, fator).
 */

/*
 * MODO PÂNICO (recuperação de erros)
 *
 * As regras abaixo envolvem a sua parte em try/catch. Ao encontrar um erro,
 * o catch chama consumeUntil(g, e, "regra"), que registra o erro e descarta
 * tokens até achar um do conjunto de sincronização g (classe Follow).
 * Em seguida a regra devolve um nó "erro" no lugar do trecho descartado,
 * e a análise continua: todos os erros aparecem numa única compilação.
 */

No inicio() throws ParseEOFException :
{ No no = new No("inicio"); Token t; No filho; raiz = no; }
{
  try {
    t = < ABREMAIN >   { no.add(t); }
    t = < ABREPAREN >  { no.add(t); }
    t = < FECHAPAREN > { no.add(t); }
  }
  catch (ParseException e) {
    consumeUntil(Follow.cabecalho, e, "inicio (apito_inicial)");
    no.add(No.erro("cabeçalho descartado"));
  }
    ( filho = comando() { no.add(filho); } )*
  try {
    t = < FECHAMAIN >  { no.add(t); }
    < EOF >
  }
  catch (ParseException e) {
    // token fora de lugar no nível do programa (ex.: "}" sobrando):
    // descarta o trecho e retoma a análise dos comandos seguintes
    while (true) {
      consumeUntil(Follow.programa, e, "inicio (fim_de_jogo)");
      no.add(No.erro("trecho descartado"));
      while (First.comando.contains(getToken(1).kind))
        no.add(comando());
      boolean fechou = false;
      if (getToken(1).kind == FECHAMAIN) {
        no.add(getNextToken());
        fechou = true;
      }
      if (getToken(1).kind == EOF)
        break;
      // depois do fim_de_jogo só pode vir o fim do arquivo
      e = erroEsperando(fechou ? new RecoverySet(EOF) : Follow.programa);
    }
  }
  { return no; }
}

/*
 * Ponto principal de sincronização: um erro em qualquer comando (declaração,
 * atribuição, if, while, for) é tratado aqui. O conjunto de sincronização é
 * Follow(comando): o início do próximo comando, "}" ou "fim_de_jogo".
 */
No comando() throws ParseEOFException :
{ No no = new No("comando"); No filho; RecoverySet g = Follow.comando; }
{
  try {
    (
        filho = declaraVar()
      | filho = atribuicaoIsolada()
      | filho = comandoIf()
      | filho = comandoWhile()
      | filho = comandoFor()
    )
    { return no.add(filho); }
  }
  catch (ParseException e) {
    consumeUntil(g, e, "comando");
    return no.add(No.erro("comando descartado"));
  }
}

No tipoDado() :
{ No no = new No("tipoDado"); Token t; }
{
  ( t = < TIPOINT > | t = < TIPOFLOAT > | t = < TIPOSTRING > )
  { return no.add(t); }
}

No valor() :
{ No no = new No("valor"); Token t; }
{
  ( t = < CONSTANT > | t = < FLOAT_LIT > | t = < STRING_LIT > | t = < IDENTIFICADOR > )
  { return no.add(t); }
}

/*
 * Expressões em níveis de precedência (do menor para o maior):
 *   expressao : comparação (no máximo um operador relacional)
 *   exprArit  : soma e subtração      (associativas à esquerda)
 *   termo     : multiplicação e divisão (associativas à esquerda)
 *   fator     : valor, parênteses ou sinal unário
 *
 * Como termo fica dentro de exprArit, em "2 + 3 * 4" o * aparece abaixo do +.
 */
No expressao() :
{ No no = new No("expressao"); Token t; No filho; }
{
    filho = exprArit() { no.add(filho); }
    (
      t = < OP_REL > filho = exprArit() { no.add(t).add(filho); }
    )?
    { return no; }
}

No exprArit() :
{ No no = new No("exprArit"); Token t; No filho; }
{
    filho = termo() { no.add(filho); }
    (
      t = < OP_SOMA > filho = termo() { no.add(t).add(filho); }
    )*
    { return no; }
}

No termo() :
{ No no = new No("termo"); Token t; No filho; }
{
    filho = fator() { no.add(filho); }
    (
      t = < OP_MULT > filho = fator() { no.add(t).add(filho); }
    )*
    { return no; }
}

No fator() :
{ No no = new No("fator"); Token t; Token t2; No filho; }
{
  (
      filho = valor() { no.add(filho); }
    | t = < ABREPAREN > filho = expressao() t2 = < FECHAPAREN >
      { no.add(t).add(filho).add(t2); }
    | t = < OP_SOMA > filho = fator() { no.add(t).add(filho); }
  )
  { return no; }
}

/* Permite reatribuir valor a variáveis já existentes */
No atribuicaoIsolada() :
{ No no = new No("atribuicao"); Token t; No filho; }
{
    t = < IDENTIFICADOR > { no.add(t); }
    t = < ATRIBUICAO >    { no.add(t); }
    filho = expressao()   { no.add(filho); }
    t = < FIMINSTRUCT >   { no.add(t); }
    { return no; }
}

/* Declarar variáveis únicas ou em lista com/sem atribuição */
No declaraVar() :
{ No no = new No("declaraVar"); Token t; No filho; }
{
   filho = tipoDado() { no.add(filho); }
   t = < IDENTIFICADOR > { no.add(t); }
   ( t = < ATRIBUICAO > filho = expressao() { no.add(t).add(filho); } )?
   (
     t = < VIRGULA > { no.add(t); }
     t = < IDENTIFICADOR > { no.add(t); }
     ( t = < ATRIBUICAO > filho = expressao() { no.add(t).add(filho); } )?
   )*
   t = < FIMINSTRUCT > { no.add(t); }
   { return no; }
}

/*
 * Nos comandos com bloco, os comandos entre { } ficam agrupados num nó "bloco"
 * (só na árvore; a gramática continua a mesma), para separar o bloco do
 * var_analisa do bloco do segue_jogo.
 */

/* Estrutura Condicional (If / Else) */
No comandoIf() throws ParseEOFException :
{ No no = new No("comandoIf"); No bloco; Token t; No filho; }
{
    t = < IF >          { no.add(t); }
    try {
      t = < ABREPAREN >   { no.add(t); }
      filho = expressao() { no.add(filho); }
      t = < FECHAPAREN >  { no.add(t); }
    }
    catch (ParseException e) {
      consumeUntil(Follow.condicao, e, "comandoIf (condição)");
      no.add(No.erro("condição descartada"));
    }
    t = < ABREBLOCO >   { bloco = new No("bloco").add(t); no.add(bloco); }
      ( filho = comando() { bloco.add(filho); } )*
    t = < FECHABLOCO >  { bloco.add(t); }
    (
      LOOKAHEAD(1)
      t = < ELSE >        { no.add(t); }
      t = < ABREBLOCO >   { bloco = new No("bloco").add(t); no.add(bloco); }
        ( filho = comando() { bloco.add(filho); } )*
      t = < FECHABLOCO >  { bloco.add(t); }
    )?
    { return no; }
}

/* Laço 1 (While) */
No comandoWhile() throws ParseEOFException :
{ No no = new No("comandoWhile"); No bloco; Token t; No filho; }
{
    t = < WHILE >       { no.add(t); }
    try {
      t = < ABREPAREN >   { no.add(t); }
      filho = expressao() { no.add(filho); }
      t = < FECHAPAREN >  { no.add(t); }
    }
    catch (ParseException e) {
      consumeUntil(Follow.condicao, e, "comandoWhile (condição)");
      no.add(No.erro("condição descartada"));
    }
    t = < ABREBLOCO >   { bloco = new No("bloco").add(t); no.add(bloco); }
      ( filho = comando() { bloco.add(filho); } )*
    t = < FECHABLOCO >  { bloco.add(t); }
    { return no; }
}

/* Laço 2 (For) */
No comandoFor() throws ParseEOFException :
{ No no = new No("comandoFor"); No bloco; Token t; No filho; }
{
    t = < FOR >           { no.add(t); }
    try {
      t = < ABREPAREN >     { no.add(t); }
      filho = tipoDado()    { no.add(filho); }
      t = < IDENTIFICADOR > { no.add(t); }
      t = < ATRIBUICAO >    { no.add(t); }
      filho = valor()       { no.add(filho); }
      t = < FIMINSTRUCT >   { no.add(t); }
      filho = expressao()   { no.add(filho); }
      t = < FIMINSTRUCT >   { no.add(t); }
      t = < IDENTIFICADOR > { no.add(t); }
      t = < ATRIBUICAO >    { no.add(t); }
      filho = expressao()   { no.add(filho); }
      t = < FECHAPAREN >    { no.add(t); }
    }
    catch (ParseException e) {
      consumeUntil(Follow.condicao, e, "comandoFor (cabeçalho)");
      no.add(No.erro("cabeçalho descartado"));
    }
    t = < ABREBLOCO >     { bloco = new No("bloco").add(t); no.add(bloco); }
      ( filho = comando() { bloco.add(filho); } )*
    t = < FECHABLOCO >    { bloco.add(t); }
    { return no; }
}
